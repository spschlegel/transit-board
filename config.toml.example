# Transit Board Configuration
# Copy to config.toml and fill in your values.
# MBTA API key goes in .env as MBTA_API_KEY (never commit config.toml or .env)
#
# Find stop IDs at: https://api-v3.mbta.com/stops
# Find your home coordinates at: https://www.latlong.net/

[location]
lat = 42.3601    # your home latitude
lon = -71.0589   # your home longitude
walk_speed_kmh = 5.0  # walking speed used for "when to leave" (default: 5 km/h ≈ 3 mph)

# Up to 2 stops shown side-by-side in the top half of the display.
# All bus lines at a stop are included — only the 3 soonest departures are shown.
# type: "bus" or "subway"
# walk_minutes: optional hard-coded override; auto-calculated from coordinates if omitted

[[stops]]
id = "64"              # Example: Ruggles bus stop
name = "Bus"
type = "bus"
# walk_minutes = 8    # uncomment to hard-code walk time instead of auto-calculating

[[stops]]
id = "place-rugg"      # Example: Ruggles Orange Line
name = "Orange"
type = "subway"
# walk_minutes = 12

[display]
departures_per_stop = 3  # rows shown per stop (3 fills the top panel exactly)
rotation = 0             # 0 or 180 — set to 180 if the panel is mounted upside down
y_offset = 2             # px to shift the whole frame down (0 to disable)

# Brightness follows a day/night schedule rather than a fixed value.
brightness_day = 90        # 0–100 — panel brightness from day_start until night_start
brightness_night = 60      # 0–100 — panel brightness from night_start until day_start
day_start = 06:30:00       # local time brightness switches to brightness_day
night_start = 21:00:00     # local time brightness switches to brightness_night

[refresh]
transit_secs = 30        # how often to re-fetch MBTA predictions (seconds)
weather_secs = 300       # how often to re-fetch weather from Open-Meteo (seconds)
sports_secs = 120        # how often to re-fetch scores from ESPN (seconds)

# Sports scores mode — replaces some or all of the departures panel with live/
# recent scores for NFL, FC Bayern Munich (Bundesliga), Red Sox (MLB), and
# men's Grand Slam tennis. The left info column (clock/weather/UV) is never
# affected.
[sports]
mode = "transit"              # "transit" (never shown) | "sports" (always shown) | "auto" (hybrid)
nfl_enabled = true             # all NFL games, leaguewide
bayern_enabled = true          # FC Bayern Munich (Bundesliga) only
tennis_enabled = true          # men's singles, the 4 Grand Slams only
red_sox_enabled = true         # Boston Red Sox (MLB) only
post_game_window_minutes = 60  # how long a finished game stays on screen
replaceable_stop_index = 1     # which of your [[stops]] "auto" mode may replace with scores (0 or 1)
hybrid_compact_max_games = 2   # <= this many relevant games -> half-panel; more -> full takeover
prefer_scores_over_idle = true # show live/recent scores instead of the night idle animation, if any exist
